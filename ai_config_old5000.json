{
  "dataset": {
    "type": "sqlite",
    "path": "quantum_simulation.db",
    "table": "simulation_records",
    "where": "",
    "id_column": null
  },
  "features": [
    {
      "name": "qubit_radius",
      "column": "qubit_radius",
      "json_path": "qubit.radius",
      "unit": "um"
    },
    {
      "name": "qubit_gap",
      "column": "qubit_gap",
      "json_path": "qubit.gap_size",
      "unit": "um"
    },
    {
      "name": "coupler_length",
      "column": "coupler_length",
      "json_path": "coupler.length",
      "unit": "um"
    },
    {
      "name": "coupler_arc_width",
      "column": "coupler_arc_width",
      "json_path": "coupler.arc_width",
      "unit": "um"
    }
  ],



  "targets": [
    {
      "name": "EC1_MHz",
      "column": "lom_Qubit_1_Ec",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "qubits_parameters.Qubit_1.Ec_MHz"
      }
    },
    {
      "name": "ECc_MHz",
      "column": "lom_Coupler_Ec",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "qubits_parameters.Coupler.Ec_MHz"
      }
    },
    {
      "name": "EC2_MHz",
      "column": "lom_Qubit_2_Ec",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "qubits_parameters.Qubit_2.Ec_MHz"
      }
    },
    {
      "name": "g_12_MHz",
      "column": "lom_g12",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "coupling_parameters_MHz.g_12"
      }
    },
    {
      "name": "g_1c_MHz",
      "column": "lom_g1c",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "coupling_parameters_MHz.g_1c"
      }
    },
    {
      "name": "g_2c_MHz",
      "column": "lom_g2c",
      "unit": "MHz",
      "verification": {
        "file": "lom_results.json",
        "json_path": "coupling_parameters_MHz.g_2c"
      }
    }
  ],
 

  "preprocessing": {
    "validation_split": 0.1,
    "random_seed": 42,
    "fixed_std_threshold": 0.00001,
    "drop_fixed_features": true,
    "drop_duplicate_rows": true,
    "outlier_z_threshold": 5.0
  },
  "optimization": {
    "objectives": {
      "EC1_MHz": {
        "target": 190.0,
        "weight": 1.0,
        "unit": "MHz"
      },
      "ECc_MHz": {
        "target": 100.0,
        "weight": 1.0,
        "unit": "MHz"
      },
      "EC2_MHz": {
        "target": 190.0,
        "weight": 1.0,
        "unit": "MHz"
      },
      "g_12_MHz": {
        "target": 5.0,
        "weight": 2.0,
        "unit": "MHz"
      },
      "g_1c_MHz": {
        "target": 110.0,
        "weight": 1.0,
        "unit": "MHz"
      },
      "g_2c_MHz": {
        "target": 110.0,
        "weight": 1.0,
        "unit": "MHz"
      }
    }
  },
  "training": {
    "random_seed": 42,

    "surrogate": {
      "epochs": 10,
      "batch_size": 128,
      "lr": 0.001,
      "weight_decay": 0.0001,
      "early_stop": 3,
      "hidden_dims": [128, 128, 128]
    },

    "sac": {
      "lr_actor": 0.0003,
      "lr_critic": 0.0003,
      "lr_alpha": 0.0003,
      "gamma": 0.99,
      "tau": 0.005,
      "buffer_size": 20000,
      "batch_size": 128,
      "warmup_steps": 256,
      "update_per_step": 1,
      "init_alpha": 0.2,
      "hidden_dims": [128, 128, 128]
    },

    "run": {
      "total_steps": 1000,
      "bc_init_samples": 1000,
      "log_every": 100
    }
  },


  "artifacts": {
    "directory": "ai_artifacts/old5000_test",
    "processed_data": "processed_data.npz",
    "metadata": "processed_meta.json",
    "surrogate_model": "surrogate.pt",
    "sac_model": "sac_quantum.pt",
    "train_history": "train_history.json",
    "candidate": "sac_candidate.json",
    "candidate_layout_directory": "candidate_layouts",
    "verification_directory": "q3d_verifications"
  },
  "pipeline": {
    "main_pipeline_path": "main_pipeline.py",
    "base_layout_path": "layout_parameters.json",
    "ai_run_name": "AI_Q3D_Verification",
    "create_missing_json_paths": false
  }
}
